# Google Gemini API (for AI rewriting and deduplication)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: NewsAPI (https://newsapi.org). RSS feeds are used regardless.
NEWSAPI_KEY=

# News sources
RSS_FEEDS=https://www.limerickpost.ie/feed/,https://www.limerickleader.ie/rss/,https://limerickvoice.com/feed/,https://www.limerickgaa.ie/feed/,https://www.limerickchamber.ie/feed/
LIMERICK_KEYWORDS=Limerick,Munster,Shannon,Treaty City

# Pipeline settings
MIN_ARTICLE_LENGTH=100
MAX_DAILY_REWRITES=20
