{
  "name": "the-061",
  "version": "2.0.0",
  "description": "The 061 - AI-curated local news for Limerick, published to GitHub Pages",
  "scripts": {
    "scrape": "node scripts/scrape-news.js",
    "dedupe": "node scripts/ai-deduplicate.js",
    "rewrite": "node scripts/rewrite-articles.js",
    "images": "node scripts/fetch-images.js",
    "sections": "node scripts/classify-sections.js",
    "gaa": "node scripts/fetch-gaa-fixtures.js",
    "build": "node scripts/build-site.js",
    "update": "npm run scrape && npm run dedupe && npm run rewrite && npm run sections && npm run images && npm run gaa && npm run build",
    "clear-rewrites": "node scripts/clear-rewrites.js",
    "preview": "npx --yes serve site"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "limerick",
    "news",
    "ai",
    "newspaper",
    "digest"
  ],
