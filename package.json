  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "newsapi": "^2.4.1",
    "node-fetch": "^2.7.0",
    "xml2js": "^0.6.2"
  }
